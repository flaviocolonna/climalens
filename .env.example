# Server-side only. Never prefix with VITE_ — that would inline the key into
# the browser bundle and publish it to anyone who opens devtools.
OPENROUTER_API_KEY=sk-or-v1-...

# EU-only routing: pins requests to eu.openrouter.ai and constrains provider
# routing to zero data retention / no training. Defaults to true.
# OPENROUTER_EU=true

# Swap the model without touching code. Must be an endpoint that supports
# structured outputs — the request sets provider.require_parameters, so an
# incompatible model fails loudly instead of silently ignoring the schema.
# OPENROUTER_MODEL=openai/gpt-5-mini

# Optional: shared discovery cache across serverless instances (Upstash Redis,
# added via the Vercel Marketplace integration or upstash.com directly). Both
# must be set for it to take effect; without them the app falls back to an
# in-process cache that only dedupes within a single warm instance.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
